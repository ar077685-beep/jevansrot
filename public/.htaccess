DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Explicit clean routes
  RewriteRule ^admin/login/?$ admin/login/index.html [L]
  RewriteRule ^admin/orders/?$ admin/orders/index.html [L]
  RewriteRule ^admin/inventory/?$ admin/inventory/index.html [L]
  RewriteRule ^admin/customers/?$ admin/customers/index.html [L]
  RewriteRule ^admin/analytics/?$ admin/analytics/index.html [L]
  RewriteRule ^admin/settings/?$ admin/settings/index.html [L]
  RewriteRule ^admin/?$ admin/index.html [L]
  RewriteRule ^cart/?$ cart/index.html [L]
  RewriteRule ^user/?$ user/index.html [L]

  # 3. Serve real files directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 4. Serve real directories with their index.html
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^ - [L]
</IfModule>

# Custom 404 page
ErrorDocument 404 /404.html
